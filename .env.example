# multidb-mcp 连接配置示例（环境变量）
# 复制为 .env 或直接写进客户端 mcp.json 的 env 字段

# 数据库类型：dameng / sqlserver / mysql
MULTIDB_DB_TYPE=dameng

# 单连接配置
MULTIDB_HOST=192.168.0.30
MULTIDB_PORT=5236
MULTIDB_USER=SYSDBA
MULTIDB_PASSWORD=你的密码
# 达梦填 schema；SQL Server / MySQL 填数据库名
MULTIDB_SCHEMA=SYSDBA

# 只读总开关（true=仅允许 SELECT/SHOW/DESCRIBE/EXPLAIN/WITH，默认 true）
# 只有设为 false 时，下面四个细粒度写权限开关才会生效
MULTIDB_READ_ONLY=true

# 细粒度写权限：仅当 MULTIDB_READ_ONLY=false 时生效，各自默认为 false
# 某一项为 true 才允许执行对应类型的写语句，读语句始终允许
# 高危动词（GRANT/SET/CALL/EXEC/KILL/SHUTDOWN 等）与无法识别的语句一律拒绝
MULTIDB_ALLOW_INSERT=false   # INSERT / REPLACE
MULTIDB_ALLOW_UPDATE=false   # UPDATE / MERGE
MULTIDB_ALLOW_DELETE=false   # DELETE
MULTIDB_ALLOW_DDL=false      # CREATE / ALTER / DROP / TRUNCATE / RENAME

# 单次查询最大返回行数
MULTIDB_MAX_ROWS=1000

# 查询硬超时（毫秒），0 表示不限；防止慢查询卡死 MCP
MULTIDB_QUERY_TIMEOUT_MS=30000

# 慢查询阈值（毫秒），超过则审计日志标记 slow=true
MULTIDB_SLOW_QUERY_MS=1000

# 结果体积上限（字节），超过则丢弃后续行并在返回里标记 truncatedByBytes
# 防止单个大字段（BLOB/长文本）撑爆模型上下文；0 表示不限，默认 1048576 (1 MiB)
MULTIDB_MAX_RESULT_BYTES=1048576

# SQL 语句最大长度（字符），超过则拒绝；0 表示不限，默认 50000
MULTIDB_MAX_QUERY_LENGTH=50000

# 结果列脱敏规则（JSON 数组，留空则不脱敏）
# 按列名正则匹配（大小写不敏感），对 EVERY 查询结果生效（含 SELECT *）
# strategy: fixed（固定值，默认 ***）/ null（置空）/ partial（保留末尾 N 位）
# MULTIDB_MASKING_RULES=[
#   { "column": "^EMAIL$",     "strategy": "fixed" },
#   { "column": "phone|mobile","strategy": "partial", "keepLast": 4 },
#   { "column": "^ID_CARD$",   "strategy": "null" }
# ]
# 注意：正则非法或 strategy 不合法会导致配置加载失败（fail-closed），
#       宁可拒绝启动也不静默返回未脱敏的敏感数据。

# SQL Server 加密（内网自签名证书默认信任；可按需关闭）
# MSSQL_ENCRYPT=true
# MSSQL_TRUST_CERT=true

# 多连接配置（配置后覆盖单连接配置，工具调用需传 connection 参数指定连接名）
# 格式为 JSON 数组，留空则使用上面的单连接配置
# MULTIDB_CONNECTIONS=[
#   { "name": "dev",  "type": "dameng",   "host": "192.168.0.30", "port": 5236, "user": "SYSDBA", "password": "pw", "schema": "SYSDBA", "readOnly": true },
#   { "name": "prod", "type": "sqlserver", "host": "10.0.1.100",   "port": 1433, "user": "sa",    "password": "pw", "schema": "PROD",  "readOnly": false, "allowInsert": true, "allowUpdate": true },
#   { "name": "web",  "type": "mysql",     "host": "10.0.2.50",    "port": 3306, "user": "web",   "password": "pw", "schema": "appdb",  "readOnly": true }
# ]
