# multidb-mcp 配置示例
# 复制为 .env 或直接作为环境变量注入 MCP 客户端配置。

# ===== 模式一：单连接（达梦） =====
DB_TYPE=dameng
DB_HOST=192.168.0.30
DB_PORT=5236
DB_USER=SYSDBA
DB_PASSWORD=your_password
DB_SCHEMA=SYSDBA

# ===== 模式一：单连接（SQL Server） =====
# DB_TYPE=sqlserver
# DB_HOST=10.0.0.5
# DB_PORT=1433
# DB_USER=test
# DB_PASSWORD=1234
# DB_DATABASE=HBDB

# ===== 模式二：多连接（JSON 数组，推荐） =====
# DB_CONNECTIONS=[
#   {"name":"dm_dev","type":"dameng","host":"192.168.0.30","port":5236,
#    "user":"SYSDBA","password":"pw","schema":"SYSDBA","description":"达梦开发库"},
#   {"name":"mssql","type":"sqlserver","host":"10.0.0.5","port":1433,
#    "user":"test","password":"1234","database":"HBDB","sql_access":"dml","description":"SQL Server"}
# ]

# ===== 全局开关 =====
# 全局默认 SQL 访问级别: readonly / dml / ddl / full
DB_SQL_ACCESS=readonly
# execute_sql 返回行数上限（硬上限 10000）
DB_MAX_ROWS=1000
