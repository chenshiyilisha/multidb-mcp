{
  "name": "multidb-mcp",
  "version": "0.2.0",
  "description": "Lightweight MCP server for Dameng (DM8), SQL Server and MySQL databases",
  "mcpName": "io.github.chenshiyilisha/multidb-mcp",
  "type": "module",
  "license": "MIT",
  "main": "./build/index.js",
  "bin": {
    "multidb-mcp": "./build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "dameng",
    "dm8",
    "sqlserver",
    "mysql",
    "database"
  ],
  "author": "贺继海",
  "repository": {
    "type": "git",
    "url": "https://github.com/chenshiyilisha/multidb-mcp.git"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "smoke": "node tests/smoke.mjs",
    "test:unit": "node tests/unit.mjs",
    "test:db": "node tests/test_db.mjs",
    "test:perm": "node tests/permissions.mjs",
    "test:enh": "node tests/enhancements.mjs",
    "test:hard": "node tests/hardening.mjs",
    "test:prim": "node tests/primitives.mjs",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "dmdb": "^1.0.0",
    "mssql": "^11.0.0",
    "mysql2": "^3.24.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
